{
  "default_interval": {
    "description": "默认订阅检查间隔 (分钟)",
    "type": "int",
    "default": 60
  },
  "default_threshold": {
    "description": "默认普通告警阈值 (度)",
    "type": "float",
    "default": 10.0
  },
  "default_critical_threshold": {
    "description": "默认严重告警阈值 (度)",
    "type": "float",
    "default": 5.0
  },
  "admin_alert_session": {
    "description": "管理员告警接收会话 ID (可选)",
    "type": "string"
  },
  "managed_accounts": {
    "type": "template_list",
    "description": "管理员管理的账号 (可选)。校区/楼栋/房间号会自动从学校 API 查询解析。",
    "templates": {
      "account": {
        "name": "电费账号",
        "hint": "管理员统一管理的账号",
        "display_item": "student_id",
        "items": {
          "student_id": { "description": "学号", "type": "string" },
          "password": { "description": "密码", "type": "string" },
          "campus": { "description": "校区名，如 沁园, 晖园", "type": "string" },
          "building": { "description": "楼栋名，如 沁园22栋", "type": "string" },
          "room_number": { "description": "房间号，如 214", "type": "string" },
          "user_id": { "description": "绑定到的用户标识 (留空=管理员)", "type": "string", "default": "" }
        }
      }
    }
  }
}
